# Everything here is optional. Without any of it, Atlas still runs: a built-in deterministic assistant answers,
# and the scripted security demo works. Placeholders only; never commit real values. Keep all of these server-side
# (no NEXT_PUBLIC_ prefix). Real values belong in .env.local (Git-ignored), next to package.json.

# --- Option 1 (first choice): Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=
# A tool-capable model available to YOUR account. Verify with: node scripts/smoke-groq.mjs   (add --write to save it). No default.
GROQ_MODEL=
# GROQ_BASE_URL=              # default https://api.groq.com/openai/v1

# --- Option 2: OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Pick a model whose entry in https://openrouter.ai/api/v1/models lists "tools" in supported_parameters (free ones end in :free).
# No default in code. Free models have strict rate limits and daily quotas.
OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=        # default https://openrouter.ai/api/v1

# --- Option 3: OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
# A model id that YOUR account can use (see https://platform.openai.com/settings/organization/limits). No default.
OPENAI_MODEL=
# OPENAI_BASE_URL=            # default https://api.openai.com/v1 (http allowed only for localhost)

# --- Option 4: NVIDIA (https://build.nvidia.com) ---
NVIDIA_API_KEY=
# Model id from the NVIDIA catalog or your account (author/model-slug). NEMOTRON_MODEL is the primary name;
# NVIDIA_MODEL is accepted as an alias (NEMOTRON_MODEL wins if both are set). No default.
NEMOTRON_MODEL=
# NVIDIA_MODEL=
# NVIDIA_BASE_URL=            # default https://integrate.api.nvidia.com/v1

# Provider precedence: LLM_PROVIDER=groq|openrouter|openai|nvidia if set; otherwise the first provider whose key is set (Groq, OpenRouter, OpenAI, NVIDIA).
# LLM_PROVIDER=

# Optional: print one data-free JSON audit line per tool decision to the server console (Security ON only).
# ATLAS_AUDIT_STDOUT=1
