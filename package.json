{
  "name": "agentic-threat-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:apiKey": "openui generate-api-key",
    "generate": "openui generate src/lib/library.ts --spec --out src/generated/spec.json",
    "predev": "npm run generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run src/lib/agent/live.test.ts src/lib/agent/adversarial.live.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.72",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@openuidev/server": "^0.3.0",
    "ai": "^7.0.111",
    "next": "^16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
